SQLALCHEMY_DATABASE_URL="sqlite+aiosqlite:///./sql_app.db"
SQL_ECHO=false

UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_WORKERS=1
UVICORN_RELOAD=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL_SECONDS=3600
RATE_LIMIT_BUY_PER_MINUTE=10

# Login microservice (separate uvicorn process on :8001)
LOGIN_SERVICE_URL=http://127.0.0.1:8001
